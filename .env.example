# Yerel geliştirme ortam değişkenleri. Gerçek sırlar ASLA bu dosyaya yazılmaz (§13.1).
# `pnpm run setup` bu dosyayı .env olarak kopyalar.

# Ortam: local | test | staging | production
APP_ENV=local

# PostgreSQL (infra/docker-compose.yml)
DATABASE_URL=postgresql://incelemeler:incelemeler_local_only@localhost:54320/incelemeler

# API
API_PORT=4000
# Web/Admin'in sunucu tarafında API'ye eriştiği adres
API_INTERNAL_URL=http://localhost:4000

# Web ve yönetim paneli portları
WEB_PORT=3000
ADMIN_PORT=3001

# S3 uyumlu yerel depolama (SeaweedFS)
STORAGE_ADAPTER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=incelemeler-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Yerel e-posta yakalayıcı (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# İmzalı cursor anahtarı (≥ 32 karakter). `pnpm run setup` yerelde rastgele üretir.
CURSOR_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG____

# AES-256-GCM veri şifreleme anahtarı (64 hex). `pnpm run setup` yerelde rastgele üretir.
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# E-posta: mailpit (yerel yakalayıcı) | memory (test) | disabled (gerçek sağlayıcı yok — X-004)
EMAIL_ADAPTER=mailpit
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=noreply@incelemeler.local
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
