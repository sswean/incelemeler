{
  "name": "@incelemeler/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js & node --env-file-if-exists=../../.env --watch dist/worker.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset:local": "node --env-file-if-exists=../../.env scripts/reset-local.mjs",
    "seed:demo": "node --env-file-if-exists=../../.env dist/seed/demo-seed.js",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "admin:create-super-admin": "node --env-file-if-exists=../../.env dist/cli/create-super-admin.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "search:reindex": "node --env-file-if-exists=../../.env dist/cli/search-reindex.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@incelemeler/contracts": "workspace:*",
    "@incelemeler/i18n": "workspace:*",
    "@incelemeler/routes": "workspace:*",
    "@incelemeler/utils": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "blurhash": "2.0.5",
    "image-size": "2.0.4",
    "jpeg-js": "0.4.4",
    "pg": "^8.23.1",
    "pngjs": "7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  }
}
