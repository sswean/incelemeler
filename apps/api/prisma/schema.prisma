// İncelemeler veri modeli — Faz 0 yürüyen iskelet çekirdeği.
// Tam model Faz 1 dilimlerinde ADR-0004'e göre genişletilir (Ek A2).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Listeleme türleri — kodla tanımlı, sabit (Ç-11, Ek A2.2).
enum ListingKind {
  PLACE
  LODGING
  PRODUCT
  SERVICE_PROVIDER
  GUIDE_PERSON
  EXPERIENCE
  POI
  DESTINATION
  EVENT
  WORK
}

enum AttributeType {
  BOOL
  ENUM
  MULTI_ENUM
  INT
  DECIMAL
  TEXT
  DATE
}

enum CategoryStatus {
  DRAFT
  HIDDEN
  PUBLISHED
}

/// Verinin kökeni (§12.4). DEMO kayıtlar üretim yüzeylerine giremez.
enum DataOrigin {
  DEMO
  EDITORIAL
  USER
  OWNER
  PROVIDER
  IMPORT
}

/// Kategori = veri (REQ-VER-002). Ağaç: parentId (Faz 1'de closure/ltree değerlendirilir).
model Category {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  slug                   String                  @unique
  name                   String
  parentId               String?                 @map("parent_id") @db.Uuid
  parent                 Category?               @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children               Category[]              @relation("CategoryTree")
  allowedKinds           ListingKind[]           @map("allowed_kinds")
  status                 CategoryStatus          @default(DRAFT)
  sortOrder              Int                     @default(0) @map("sort_order")
  ymyl                   Boolean                 @default(false)
  requiresExpertReview   Boolean                 @default(false) @map("requires_expert_review")
  ugcEnabled             Boolean                 @default(true) @map("ugc_enabled")
  sponsorshipAllowed     Boolean                 @default(true) @map("sponsorship_allowed")
  requiresLicense        Boolean                 @default(false) @map("requires_license")
  dataOrigin             DataOrigin              @default(EDITORIAL) @map("data_origin")
  /// İlk yayın anı; yayımlanmış kategorinin slug'ı değişmez (A-011).
  firstPublishedAt       DateTime?               @map("first_published_at") @db.Timestamptz(3)
  /// Geçerli (kendi + devralınan) özellik şemasının sürümü; her şema değişikliğinde artar (REQ-VER-003).
  attributeSchemaVersion Int                     @default(0) @map("attribute_schema_version")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                Int                     @default(1)
  listings               Listing[]
  attributes             AttributeDefinition[]
  criteria               ReviewCriterion[]
  schemaVersions         CategorySchemaVersion[]
  listingCategories      ListingCategory[]
  legalApprovals         LegalApproval[]
  importBatches          ImportBatch[]

  @@index([status, sortOrder, id])
  @@index([parentId])
  @@map("categories")
}

/// Değiştirilemez denetim kaydı (REQ-VER-017). Uygulama rolü yalnızca INSERT yapabilir (migration'da tetikleyici).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  summary    Json?
  ipPrefix   String?  @map("ip_prefix")
  traceId    String?  @map("trace_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

enum OrganizationType {
  BUSINESS
  BRAND
  CHAIN
  OPERATOR
  ADVERTISER
}

/// Kuruluş: işletme, marka, zincir, operatör, reklamveren (REQ-VER-008). Faz 1'de üyelikler eklenir.
model Organization {
  id         String           @id @default(uuid(7)) @db.Uuid
  type       OrganizationType
  slug       String           @unique
  name       String
  dataOrigin DataOrigin       @default(EDITORIAL) @map("data_origin")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int              @default(1)
  listings   Listing[]
  campaigns  Campaign[]

  @@map("organizations")
}

enum ListingStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  CLOSED_TEMPORARILY
  CLOSED_PERMANENTLY
  ARCHIVED
}

/// Listeleme ortak alanları (REQ-VER-001). Tür özel alanlar 1:1 uzantı tablolarında (Faz 1),
/// kategoriye özgü alanlar `attributes` JSONB içinde kategori şemasına karşı doğrulanır (REQ-VER-003).
/// primaryMediaId, medya modeli (REQ-VER-014) ile birlikte Faz 1'de FK olarak eklenir.
model Listing {
  id                     String        @id @default(uuid(7)) @db.Uuid
  kind                   ListingKind
  slug                   String        @unique
  name                   String
  shortDescription       String?       @map("short_description")
  /// "Hakkında" bölümü: blok JSON (REQ-LST-010)
  description            Json?
  primaryCategoryId      String        @map("primary_category_id") @db.Uuid
  primaryCategory        Category      @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  organizationId         String?       @map("organization_id") @db.Uuid
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status                 ListingStatus @default(DRAFT)
  /// Göreli fiyat seviyesi 1–4 (REQ-VER-011); CHECK kısıtı migration'da.
  priceLevel             Int?          @map("price_level") @db.SmallInt
  attributes             Json          @default("{}")
  attributeSchemaVersion Int           @default(1) @map("attribute_schema_version")
  /// İletişim kanalları: { phone?, website?, email?, reservationUrl? } (zod ile doğrulanır)
  contacts               Json          @default("{}")
  /// Toplu içe aktarmayla oluşturulduysa işlem kimliği (REQ-LST-007, geri alma için)
  importBatchId          String?       @map("import_batch_id") @db.Uuid
  importBatch            ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  dataOrigin             DataOrigin    @map("data_origin")
  /// Bilginin kaynağı (§12.4): editör girişi, işletme beyanı, lisanslı veri…
  source                 String
  sourceVerifiedAt       DateTime?     @map("source_verified_at") @db.Timestamptz(3)
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(3)
  version                Int           @default(1)

  secondaryCategories ListingCategory[]
  location            ListingLocation?
  serviceAreas        ListingServiceArea[]
  lodging             ListingLodging?
  product             ListingProduct?
  experience          ListingExperience?
  event               ListingEvent?        @relation("EventDetails")
  hostedEvents        ListingEvent[]       @relation("EventVenue")
  guide               ListingGuide?
  reviews             Review[]
  ratingStats         ListingRatingStats?
  outboundLinks       OutboundLink[]
  reviewDrafts        ReviewDraft[]
  campaignPlacements  CampaignPlacement[]
  favorites           Favorite[]

  @@index([kind, status, primaryCategoryId])
  @@index([organizationId])
  @@index([importBatchId])
  @@map("listings")
}

// ───────────────────────── Kimlik ve erişim (Ek A3, ADR-0003) ─────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

/// Personel rolleri (§7.1). İşletme/reklamveren rolleri global değildir (Faz 3, kuruluş üyeliği).
enum StaffRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  MODERATOR
  SALES
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  DELETE_ACCOUNT
  CANCEL_DELETION
}

model User {
  id                  String                @id @default(uuid(7)) @db.Uuid
  /// Küçük harfe çevrilmiş ve normalize edilmiş e-posta; benzersiz.
  email               String                @unique
  emailVerifiedAt     DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  passwordHash        String                @map("password_hash")
  displayName         String                @map("display_name")
  status              UserStatus            @default(ACTIVE)
  /// 18+ beyanı (REQ-HSP-014)
  ageConfirmedAt      DateTime              @map("age_confirmed_at") @db.Timestamptz(3)
  termsVersion        String                @map("terms_version")
  deletionRequestedAt DateTime?             @map("deletion_requested_at") @db.Timestamptz(3)
  dataOrigin          DataOrigin            @default(USER) @map("data_origin")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             Int                   @default(1)
  roles               StaffRoleAssignment[]
  sessions            Session[]
  uploadedMedia       MediaAsset[]
  importBatches       ImportBatch[]
  authoredArticles    Article[]             @relation("ArticleAuthor")
  editedArticles      Article[]             @relation("ArticleEditor")
  contentRevisions    ContentRevision[]
  authorProfile       AuthorProfile?
  emailTokens         EmailToken[]
  mfaFactor           MfaFactor?
  recoveryCodes       RecoveryCode[]
  reviews             Review[]              @relation("ReviewAuthor")
  moderatedReviews    Review[]              @relation("ReviewModerator")
  reviewDrafts        ReviewDraft[]
  reports             ContentReport[]       @relation("ReportReporter")
  decidedReports      ContentReport[]       @relation("ReportDecider")
  appeals             ModerationAppeal[]    @relation("AppealAppellant")
  outboundLinks       OutboundLink[]
  decidedAppeals      ModerationAppeal[]    @relation("AppealDecider")
  favorites           Favorite[]

  @@index([status])
  @@map("users")
}

model StaffRoleAssignment {
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StaffRole
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@id([userId, role])
  @@map("staff_roles")
}

/// Sunucu tarafı oturum; istemcide yalnızca opak token, veritabanında SHA-256 karması (REQ-HSP-004).
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  isStaff           Boolean   @default(false) @map("is_staff")
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  stepUpAt          DateTime? @map("step_up_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Kısaltılmış IP (IPv4 /24, IPv6 /48) — ham IP saklanmaz (REQ-KVK-025)
  ipPrefix          String?   @map("ip_prefix")
  userAgent         String?   @map("user_agent")

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Tek kullanımlık e-posta token'ları; yalnızca karma saklanır.
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// TOTP ikinci faktör; gizli anahtar AES-256-GCM ile şifreli (REQ-GUV-010).
model MfaFactor {
  userId          String    @id @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("mfa_factors")
}

model RecoveryCode {
  id       String    @id @default(uuid(7)) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("recovery_codes")
}

/// Sabit pencereli hız sınırı sayacı (Redis yok, A-006).
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limit_buckets")
}

/// Transactional outbox (REQ-MIM-015, ADR-0010): domain değişikliğiyle aynı işlemde yazılır, worker işler.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  /// Kişisel veri içermez; yalnızca kimlikler ve değişen alan adları.
  payload       Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Bir sonraki deneme zamanı; işlenirken kiralama (lease) süresi kadar ileri alınır.
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Kategoriye bağlı tipli özellik (REQ-VER-003). Anahtar ve tip değişmez; silme yerine arşiv.
model AttributeDefinition {
  id         String        @id @default(uuid(7)) @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  key        String
  label      String
  type       AttributeType
  /// ENUM/MULTI_ENUM seçenekleri: [{ value, label }]
  options    Json          @default("[]")
  unit       String?
  filterable Boolean       @default(false)
  showOnCard Boolean       @default(false) @map("show_on_card")
  required   Boolean       @default(false)
  /// { min?, max?, maxLength? }
  validation Json          @default("{}")
  sortOrder  Int           @default(0) @map("sort_order")
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version    Int           @default(1)

  @@unique([categoryId, key])
  @@map("attribute_definitions")
}

/// Kategorinin geçerli özellik şemasının değişmez anlık görüntüsü (REQ-VER-003).
model CategorySchemaVersion {
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  version     Int
  /// Etkin tanımlar (kendi + üstler): [{ key, label, type, options, unit, required, validation, … }]
  definitions Json
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([categoryId, version])
  @@map("category_schema_versions")
}

/// Değerlendirme kriteri (Ek A6.3): kategori düğümü başına en fazla 6 etkin kriter.
model ReviewCriterion {
  id          String    @id @default(uuid(7)) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  key         String
  name        String
  description String?
  required    Boolean   @default(false)
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)

  @@unique([categoryId, key])
  @@map("review_criteria")
}

enum AdminAreaLevel {
  PROVINCE
  DISTRICT
}

/// İdari bölgeler (REQ-VER-009): il → ilçe. Referans verisi migration ile yüklenir (ADR-0011).
model AdminArea {
  id                String               @id @default(uuid(7)) @db.Uuid
  level             AdminAreaLevel
  name              String
  slug              String
  /// İl plaka kodu (yalnızca PROVINCE)
  code              String?
  parentId          String?              @map("parent_id") @db.Uuid
  parent            AdminArea?           @relation("AdminAreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          AdminArea[]          @relation("AdminAreaTree")
  provinceLocations ListingLocation[]    @relation("LocationProvince")
  districtLocations ListingLocation[]    @relation("LocationDistrict")
  serviceAreas      ListingServiceArea[]
  aliases           PlaceAlias[]

  @@unique([parentId, slug])
  @@index([level])
  @@map("admin_areas")
}

/// İkincil kategoriler: en fazla 3, birincil kategoriyle aynı türe izin veren (Ek A4.1).
model ListingCategory {
  listingId  String   @map("listing_id") @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([listingId, categoryId])
  @@index([categoryId])
  @@map("listing_categories")
}

/// Konum (REQ-VER-009): koordinat 6 ondalık; `geo` sütunu migration'da üretilen PostGIS sütunudur.
model ListingLocation {
  listingId    String                                @id @map("listing_id") @db.Uuid
  listing      Listing                               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  provinceId   String                                @map("province_id") @db.Uuid
  province     AdminArea                             @relation("LocationProvince", fields: [provinceId], references: [id], onDelete: Restrict)
  districtId   String?                               @map("district_id") @db.Uuid
  district     AdminArea?                            @relation("LocationDistrict", fields: [districtId], references: [id], onDelete: Restrict)
  neighborhood String?
  addressLine  String?                               @map("address_line")
  postalCode   String?                               @map("postal_code")
  latitude     Decimal?                              @db.Decimal(9, 6)
  longitude    Decimal?                              @db.Decimal(9, 6)
  /// Enlem/boylamdan tetikleyiciyle doldurulan PostGIS noktası (migration); uygulama yazmaz.
  geo          Unsupported("geography(Point,4326)")?

  @@index([provinceId, districtId])
  @@index([geo], type: Gist)
  @@map("listing_locations")
}

/// Hizmet bölgesi (hizmet işletmesi, turist rehberi): il düzeyinde.
model ListingServiceArea {
  listingId  String    @map("listing_id") @db.Uuid
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  provinceId String    @map("province_id") @db.Uuid
  province   AdminArea @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  @@id([listingId, provinceId])
  @@map("listing_service_areas")
}

/// Konaklama uzantısı: turizm belge numarası hukuki kapıya tabidir (Ek A4.4, Ek D1).
model ListingLodging {
  listingId         String    @id @map("listing_id") @db.Uuid
  listing           Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tourismLicenseNo  String?   @map("tourism_license_no")
  licenseVerifiedAt DateTime? @map("license_verified_at") @db.Timestamptz(3)
  checkInTime       String?   @map("check_in_time")
  checkOutTime      String?   @map("check_out_time")

  @@map("listing_lodging")
}

model ListingProduct {
  listingId   String    @id @map("listing_id") @db.Uuid
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  brand       String
  model       String
  gtin        String?   @unique
  releaseDate DateTime? @map("release_date") @db.Date

  @@index([brand, model])
  @@map("listing_product")
}

model ListingExperience {
  listingId       String  @id @map("listing_id") @db.Uuid
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  durationMinutes Int?    @map("duration_minutes")
  startPoint      String? @map("start_point")

  @@map("listing_experience")
}

model ListingEvent {
  listingId      String    @id @map("listing_id") @db.Uuid
  listing        Listing   @relation("EventDetails", fields: [listingId], references: [id], onDelete: Cascade)
  startsAt       DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(3)
  venueListingId String?   @map("venue_listing_id") @db.Uuid
  venue          Listing?  @relation("EventVenue", fields: [venueListingId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@map("listing_event")
}

/// Turist rehberi uzantısı: ruhsat doğrulaması ve kişinin açık rızası olmadan yayın yok (Ek A4.4).
model ListingGuide {
  listingId         String    @id @map("listing_id") @db.Uuid
  listing           Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  languages         String[]
  licenseVerifiedAt DateTime? @map("license_verified_at") @db.Timestamptz(3)
  consentAt         DateTime? @map("consent_at") @db.Timestamptz(3)

  @@map("listing_guide")
}

/// Eski slug'lar kalıcı 301 için saklanır (REQ-VER-013).
model SlugHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  slug       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([entityType, slug])
  @@index([entityType, entityId])
  @@map("slug_history")
}

/// Hukuki kapı onayı (REQ-KAT-004, Ek D1): YMYL/lisanslı kategoride gerçek listeleme yayını için.
/// Üretimde yalnızca İnsan onayıyla yazılır (C sınıfı); `TEST-FIXTURE` onayı üretimde yok sayılır.
model LegalApproval {
  id         String    @id @default(uuid(7)) @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedBy String    @map("approved_by")
  note       String?
  approvedAt DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([categoryId])
  @@map("legal_approvals")
}

enum MediaStatus {
  READY
  REJECTED
}

/// Ek A14.6 kaynak türleri: editör çekimi, işletme (yazılı izinli), kullanıcı (lisans beyanlı), lisanslı stok.
enum MediaSourceType {
  EDITOR
  OWNER
  USER
  STOCK
}

/// Medya varlığı (REQ-VER-014). EXIF/GPS silinmiş özgün dosya depoda; varyantlar teslimde üretilir (ADR-0007).
model MediaAsset {
  id                   String           @id @default(uuid(7)) @db.Uuid
  storageKey           String           @unique @map("storage_key")
  mime                 String
  bytes                Int
  width                Int
  height               Int
  /// Odak noktası (0–1), kırpma için
  focalX               Decimal          @default(0.5) @map("focal_x") @db.Decimal(4, 3)
  focalY               Decimal          @default(0.5) @map("focal_y") @db.Decimal(4, 3)
  blurhash             String?
  altText              String?          @map("alt_text")
  status               MediaStatus      @default(READY)
  exifStripped         Boolean          @default(false) @map("exif_stripped")
  sha256               String
  // Lisans alanları (Ek A14.6) — eksikse görsel yayımlanamaz
  sourceType           MediaSourceType? @map("source_type")
  rightsHolder         String?          @map("rights_holder")
  licenseType          String?          @map("license_type")
  permissionRef        String?          @map("permission_ref")
  licenseExpiresAt     DateTime?        @map("license_expires_at") @db.Timestamptz(3)
  modelPropertyRelease Boolean?         @map("model_property_release")
  uploadedById         String           @map("uploaded_by_id") @db.Uuid
  uploadedBy           User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  dataOrigin           DataOrigin       @map("data_origin")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int              @default(1)
  usages               MediaUsage[]

  @@index([uploadedById])
  @@map("media_assets")
}

/// Medyanın kullanıldığı yerler (çoklu kullanım).
model MediaUsage {
  id         String     @id @default(uuid(7)) @db.Uuid
  mediaId    String     @map("media_id") @db.Uuid
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  /// PRIMARY (kapak) ya da GALLERY
  role       String
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([mediaId, entityType, entityId])
  @@index([entityType, entityId, sortOrder])
  @@map("media_usages")
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  ROLLED_BACK
}

/// Toplu içe aktarma işlemi (REQ-LST-007): önizleme → onay → (gerekirse) geri alma.
model ImportBatch {
  id                String       @id @default(uuid(7)) @db.Uuid
  kind              ListingKind
  primaryCategoryId String       @map("primary_category_id") @db.Uuid
  primaryCategory   Category     @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  /// Verinin kaynağı (ZORUNLU): lisanslı veri, işletme beyanı, editör derlemesi… Scraping yasak (AK-07).
  source            String
  fileName          String?      @map("file_name")
  status            ImportStatus @default(PREVIEW)
  /// Başlık → alan eşlemesi
  mapping           Json
  /// Satır satır doğrulama raporu ve normalize değerler
  rows              Json
  rowCount          Int          @map("row_count")
  validCount        Int          @map("valid_count")
  createdCount      Int          @default(0) @map("created_count")
  createdById       String       @map("created_by_id") @db.Uuid
  createdBy         User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt       DateTime?    @map("committed_at") @db.Timestamptz(3)
  rolledBackAt      DateTime?    @map("rolled_back_at") @db.Timestamptz(3)
  listings          Listing[]

  @@index([createdAt])
  @@map("import_batches")
}

enum ArticleType {
  GUIDE
  LIST
  COMPARISON
  REVIEW
  NEWS
  SPONSORED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CommercialRelation {
  NONE
  GIFTED
  SPONSORED
  AFFILIATE
}

enum ExperienceType {
  TESTED_IN_PERSON
  VISITED
  STAYED
  USED_LONG_TERM
  RESEARCH_ONLY
}

/// Editoryal içerik (REQ-ICR-001…009): gövde zod şemalı JSON blok dizisi.
model Article {
  id                      String             @id @default(uuid(7)) @db.Uuid
  type                    ArticleType
  slug                    String             @unique
  title                   String
  summary                 String?
  body                    Json               @default("[]")
  heroMediaId             String?            @map("hero_media_id") @db.Uuid
  sources                 Json               @default("[]")
  status                  ArticleStatus      @default(DRAFT)
  /// Menfaat beyanı sorusu yanıtlandı mı (REQ-ICR-008)
  interestDeclared        Boolean            @default(false) @map("interest_declared")
  commercialRelation      CommercialRelation @default(NONE) @map("commercial_relation")
  experienceType          ExperienceType?    @map("experience_type")
  experienceNote          String?            @map("experience_note")
  selectionMethod         String?            @map("selection_method")
  authorId                String             @map("author_id") @db.Uuid
  author                  User               @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editorId                String?            @map("editor_id") @db.Uuid
  editor                  User?              @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: Restrict)
  /// Sponsorlu içerikte ticari açıklama kontrolünü yapan yönetici (REQ-ICR-005)
  disclosureCheckedById   String?            @map("disclosure_checked_by_id") @db.Uuid
  scheduledAt             DateTime?          @map("scheduled_at") @db.Timestamptz(3)
  publishedAt             DateTime?          @map("published_at") @db.Timestamptz(3)
  lastSignificantUpdateAt DateTime?          @map("last_significant_update_at") @db.Timestamptz(3)
  /// [{ date, note }] — güncelleme notları ve düzeltmeler (REQ-ICR-006/009)
  updateNotes             Json               @default("[]") @map("update_notes")
  corrections             Json               @default("[]")
  dataOrigin              DataOrigin         @default(EDITORIAL) @map("data_origin")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?          @map("deleted_at") @db.Timestamptz(3)
  version                 Int                @default(1)
  revisions               ContentRevision[]

  @@index([status, type, publishedAt])
  @@index([authorId])
  @@index([status, scheduledAt])
  @@map("articles")
}

/// İçerik revizyonları (REQ-VER-015): her kayıtta önceki hâlin anlık görüntüsü.
model ContentRevision {
  id          String   @id @default(uuid(7)) @db.Uuid
  articleId   String   @map("article_id") @db.Uuid
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  actorId     String   @map("actor_id") @db.Uuid
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  changeNote  String?  @map("change_note")
  significant Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([articleId, version])
  @@map("content_revisions")
}

/// Yazar/editör profili (REQ-ICR-011).
model AuthorProfile {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  slug      String   @unique
  title     String?
  bio       String?
  expertise String[]
  ethics    String?
  links     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)

  @@map("author_profiles")
}

// ── Arama (REQ-ARA-001…014, ADR-0012) ──

enum SearchDocType {
  LISTING
  ARTICLE
  CATEGORY
  PLACE
}

/// Arama okuma modeli (REQ-ARA-002): yalnızca SearchPort (PostgresSearchAdapter) ham SQL ile yazar;
/// outbox olaylarıyla güncellenir, `search:reindex` ile baştan kurulur.
model SearchDocument {
  id          String                                @id @default(uuid(7)) @db.Uuid
  docType     SearchDocType                         @map("doc_type")
  refId       String                                @map("ref_id") @db.Uuid
  title       String
  subtitle    String?
  path        String
  /// normalizeTr(title).folded — trigram benzerlik geri dönüşü ve öneriler için.
  nameFold    String                                @map("name_fold")
  tsv         Unsupported("tsvector")
  kind        ListingKind?
  articleType ArticleType?                          @map("article_type")
  /// Birincil + ikincil kategoriler ve tüm ataları.
  categoryIds String[]                              @map("category_ids") @db.Uuid
  provinceId  String?                               @map("province_id") @db.Uuid
  districtId  String?                               @map("district_id") @db.Uuid
  priceLevel  Int?                                  @map("price_level") @db.SmallInt
  attributes  Json                                  @default("{}")
  status      String?
  dataOrigin  DataOrigin                            @map("data_origin")
  /// Yayımlanmış kullanıcı değerlendirmesi sayısı ve Bayes puanı (D7'de doldurulur; ticari sinyal yok).
  ratingCount Int                                   @default(0) @map("rating_count")
  /// Gösterilen ortalama (filtre "≥ 4" bunu kullanır; yalnızca n ≥ 3 iken dolu).
  ratingAvg   Decimal?                              @map("rating_avg") @db.Decimal(3, 2)
  ratingBayes Decimal?                              @map("rating_bayes") @db.Decimal(5, 3)
  geo         Unsupported("geography(Point,4326)")?
  publishedAt DateTime?                             @map("published_at") @db.Timestamptz(3)
  indexedAt   DateTime                              @default(now()) @map("indexed_at") @db.Timestamptz(3)

  @@unique([docType, refId])
  @@index([tsv], type: Gin)
  @@index([nameFold(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([categoryIds], type: Gin)
  @@index([provinceId, districtId])
  @@index([geo], type: Gist)
  @@map("search_documents")
}

/// Yer adı takma adları (gazetteer, Ek A7.1): "Kapadokya" → Nevşehir.
model PlaceAlias {
  id          String    @id @default(uuid(7)) @db.Uuid
  alias       String
  aliasFold   String    @unique @map("alias_fold")
  adminAreaId String    @map("admin_area_id") @db.Uuid
  adminArea   AdminArea @relation(fields: [adminAreaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("place_aliases")
}

/// Eş anlamlılar (panelden yönetilir): katlanmış ifade → katlanmış ifade.
model SearchSynonym {
  id          String   @id @default(uuid(7)) @db.Uuid
  term        String   @unique
  replacement String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_synonyms")
}

/// Niyet/özellik eşlemesi (panelden yönetilir): ifade → yapılandırılmış filtre.
model SearchIntent {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  label     String
  /// Katlanmış ifadeler.
  terms     String[]
  /// { priceLevelMax?, attributes?: { key: value } } — zod ile doğrulanır.
  filter    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_intents")
}

/// Arama olayları (REQ-ARA-014): kişisel veri yok; oturum karması yalnızca analitik rızasıyla.
model SearchEvent {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  queryNorm   String   @map("query_norm")
  filters     Json     @default("{}")
  resultCount Int      @map("result_count")
  sessionHash String?  @map("session_hash")

  @@index([createdAt])
  @@index([queryNorm])
  @@map("search_events")
}

/// Panelden yönetilen platform ayarları (ör. yayın eşikleri); değer zod ile doğrulanır.
model PlatformSetting {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

// ── Değerlendirmeler ve moderasyon (REQ-VER-006/007, REQ-DEG-*, REQ-GUN-*) ──

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
  WITHDRAWN
}

enum ReviewVerification {
  SELF_DECLARED
  DOCUMENTED
  PROVIDER_VERIFIED
}

/// PRE: yayından önce insan onayı · POST: otomatik kontrollerden geçti, yayında; sonradan incelenir.
enum ModerationMode {
  PRE
  POST
}

/// Kullanıcı değerlendirmesi. Üye başına listeleme başına 1 aktif kayıt (kısmi benzersiz indeks — migration).
/// Editör puanıyla birleştirilmez; ayrı tablo/alan (REQ-VER-004).
model Review {
  id              String                 @id @default(uuid(7)) @db.Uuid
  listingId       String                 @map("listing_id") @db.Uuid
  listing         Listing                @relation(fields: [listingId], references: [id], onDelete: Restrict)
  userId          String                 @map("user_id") @db.Uuid
  user            User                   @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  rating          Int                    @db.SmallInt
  title           String?
  body            String
  /// [{ criterionId, rating }]
  criteriaRatings Json                   @default("[]") @map("criteria_ratings")
  /// YYYY-AA (ürün dışı türlerde zorunlu)
  experienceMonth String?                @map("experience_month")
  usageDuration   String?                @map("usage_duration")
  visitContext    String?                @map("visit_context")
  verification    ReviewVerification     @default(SELF_DECLARED)
  /// Teşvik beyanı: evetse etiketli yayımlanır, ortalamaya girmez.
  incentivized    Boolean
  /// "Deneyim bana ait" ve "çıkar ilişkim yok" beyanlarının zamanı.
  declaredAt      DateTime               @map("declared_at") @db.Timestamptz(3)
  status          ReviewStatus
  moderationMode  ModerationMode         @map("moderation_mode")
  riskScore       Int                    @default(0) @map("risk_score")
  /// Otomatik kontrol sinyalleri [{ code, weight, detail }] — tek başına ceza vermez.
  signals         Json                   @default("[]")
  /// Son moderasyon incelemesi tamamlandı mı (POST modunda).
  reviewedAt      DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  reasonCode      String?                @map("reason_code")
  reasonNote      String?                @map("reason_note")
  moderatedById   String?                @map("moderated_by") @db.Uuid
  moderatedBy     User?                  @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  moderatedAt     DateTime?              @map("moderated_at") @db.Timestamptz(3)
  language        String                 @default("tr")
  dataOrigin      DataOrigin             @default(USER) @map("data_origin")
  /// İstemci IP öneki (kısaltılmış; hız/küme sinyali — Ek A17).
  ipPrefix        String?                @map("ip_prefix")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedAt     DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(3)
  publishedAt     DateTime?              @map("published_at") @db.Timestamptz(3)
  editedAt        DateTime?              @map("edited_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int                    @default(1)
  revisions       ReviewRevision[]
  appeals         ModerationAppeal[]
  removalRequests ReviewRemovalRequest[]

  @@index([listingId, status, publishedAt(sort: Desc)])
  @@index([userId, createdAt])
  @@index([status, submittedAt])
  @@map("reviews")
}

model ReviewRevision {
  id              String   @id @default(uuid(7)) @db.Uuid
  reviewId        String   @map("review_id") @db.Uuid
  review          Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rating          Int      @db.SmallInt
  title           String?
  body            String
  criteriaRatings Json     @map("criteria_ratings")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([reviewId, createdAt])
  @@map("review_revisions")
}

/// Üye taslağı (A6.4 sürtünme azaltma): hesapta otomatik kayıt.
model ReviewDraft {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id") @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, listingId])
  @@map("review_drafts")
}

/// Türetilmiş puan istatistiği (REQ-VER-007): elle düzenlenmez; outbox ile yeniden hesaplanır.
model ListingRatingStats {
  listingId    String   @id @map("listing_id") @db.Uuid
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  count        Int
  sum          Int
  average      Decimal? @db.Decimal(3, 2)
  /// [n1, n2, n3, n4, n5]
  distribution Json
  /// [{ criterionId, name, average, count }]
  criteria     Json     @default("[]")
  last12Count  Int      @map("last12_count")
  last12Avg    Decimal? @map("last12_avg") @db.Decimal(3, 2)
  /// (C·m + Σ) / (C + n); m = grup ortalaması (A6.2)
  bayes        Decimal  @db.Decimal(5, 3)
  prior        Decimal  @db.Decimal(4, 3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("listing_rating_stats")
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

/// Bildirimler (REQ-GUN-002): hedef türü genişletilebilir (fotoğraf, soru-cevap, işletme yanıtı — sonraki fazlar).
model ContentReport {
  id            String             @id @default(uuid(7)) @db.Uuid
  targetType    String             @map("target_type")
  targetId      String             @map("target_id") @db.Uuid
  reason        String
  description   String?
  reporterId    String?            @map("reporter_id") @db.Uuid
  reporter      User?              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  /// Misafir bildiriminde durum bildirimi için; karar sonrası silinir (veri minimizasyonu).
  reporterEmail String?            @map("reporter_email")
  ipPrefix      String?            @map("ip_prefix")
  status        ReportStatus       @default(OPEN)
  decidedById   String?            @map("decided_by") @db.Uuid
  decidedBy     User?              @relation("ReportDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?          @map("decided_at") @db.Timestamptz(3)
  reasonCode    String?            @map("reason_code")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  appeals       ModerationAppeal[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_reports")
}

enum AppealStatus {
  OPEN
  UPHELD
  OVERTURNED
}

/// İtiraz (REQ-GUN-003): 14 gün içinde bir kez; ilk kararı verenden farklı moderatör karar verir.
model ModerationAppeal {
  id                String         @id @default(uuid(7)) @db.Uuid
  reviewId          String?        @map("review_id") @db.Uuid
  review            Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reportId          String?        @map("report_id") @db.Uuid
  report            ContentReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appellantId       String         @map("appellant_id") @db.Uuid
  appellant         User           @relation("AppealAppellant", fields: [appellantId], references: [id], onDelete: Restrict)
  statement         String
  originalDeciderId String         @map("original_decider_id") @db.Uuid
  status            AppealStatus   @default(OPEN)
  decidedById       String?        @map("decided_by") @db.Uuid
  decidedBy         User?          @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt         DateTime?      @map("decided_at") @db.Timestamptz(3)
  note              String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([reviewId, appellantId])
  @@unique([reportId, appellantId])
  @@index([status, createdAt])
  @@map("moderation_appeals")
}

// ── Dış yönlendirme ve entegrasyon kaydı (REQ-AFF-001…007, Ek A9.3) ──

enum IntegrationStatus {
  LINK_ONLY
  SANDBOX
  LIVE
  DISABLED
}

enum OutboundKind {
  AFFILIATE
  BOOKING
  PURCHASE
  WEBSITE
  PHONE
  MESSAGING
  MAP
  QUOTE_REQUEST
}

enum OutboundStatus {
  ACTIVE
  DISABLED
  BROKEN
  EXPIRED
}

/// Sağlayıcı kaydı: API varsayılmaz; doğrulanmamışsa LINK_ONLY (AK-06). Kimlik bilgisi değil, yalnızca değişken ADLARI.
model IntegrationProvider {
  id                 String            @id @default(uuid(7)) @db.Uuid
  key                String            @unique
  name               String
  integrationStatus  IntegrationStatus @default(LINK_ONLY) @map("integration_status")
  docsUrl            String?           @map("docs_url")
  termsUrl           String?           @map("terms_url")
  termsVerifiedAt    DateTime?         @map("terms_verified_at") @db.Timestamptz(3)
  /// Yönlendirmeye izin verilen alan adları (punycode, küçük harf).
  allowedDomains     String[]          @map("allowed_domains")
  cacheTtlSeconds    Int?              @map("cache_ttl_seconds")
  credentialEnvNames String[]          @map("credential_env_names")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int               @default(1)
  links              OutboundLink[]

  @@map("integration_providers")
}

/// Merkezi dış bağlantı kaydı. Hedef yalnızca buradan okunur (açık yönlendirme yok).
model OutboundLink {
  id                 String               @id @default(uuid(7)) @db.Uuid
  listingId          String?              @map("listing_id") @db.Uuid
  listing            Listing?             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  providerId         String?              @map("provider_id") @db.Uuid
  provider           IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  kind               OutboundKind
  /// Sayfadaki eylem türü (CTA_RULES ile doğrulanır).
  ctaType            String               @map("cta_type")
  label              String?
  /// Hedef URL şablonu: yalnızca {subId} ve {surface} yer tutucuları.
  urlTemplate        String               @map("url_template")
  /// Sağlayıcısız bağlantıda izinli tek alan adı (kayıtta URL'den türetilir).
  allowedDomain      String?              @map("allowed_domain")
  commercialRelation CommercialRelation   @map("commercial_relation")
  /// İletişim bilgilerinden otomatik eşitlenen bağlantı (web sitesi, rezervasyon).
  source             String               @default("MANUAL")
  validFrom          DateTime?            @map("valid_from") @db.Timestamptz(3)
  validUntil         DateTime?            @map("valid_until") @db.Timestamptz(3)
  status             OutboundStatus       @default(ACTIVE)
  lastCheckedAt      DateTime?            @map("last_checked_at") @db.Timestamptz(3)
  lastCheckStatus    String?              @map("last_check_status")
  createdById        String?              @map("created_by") @db.Uuid
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int                  @default(1)
  clicks             OutboundClick[]

  @@index([listingId, status])
  @@index([status, lastCheckedAt])
  @@map("outbound_links")
}

/// Tıklama olayı (REQ-AFF-005): ham IP yok; günlük tuzlu oturum karması; bot/önceden getirme işaretli.
/// Aylık bölümleme veri hacmi gerektiğinde (A-020).
model OutboundClick {
  id          BigInt       @id @default(autoincrement())
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  linkId      String       @map("link_id") @db.Uuid
  link        OutboundLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  surface     String
  pageType    String       @map("page_type")
  placementId String?      @map("placement_id")
  sessionHash String       @map("session_hash")
  bot         Boolean
  prefetch    Boolean
  /// 30 sn içinde aynı oturum + bağlantı tekrarı raporlara girmez.
  counted     Boolean

  @@index([linkId, createdAt])
  @@index([sessionHash, linkId, createdAt])
  @@map("outbound_clicks")
}

enum PlacementSurface {
  SEARCH
  CATEGORY_LIST
  LISTING_DETAIL
  HOME
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum CreativeApproval {
  PENDING
  APPROVED
  REJECTED
}

enum SponsoredEventType {
  SERVED
  VIEWED
  CLICK
}

/// Yuva kataloğu (REQ-SPN-001): render noktası kodda sabit; sınırlar SURFACE_CAPS'i aşamaz (REQ-SPN-004).
model PlacementSlot {
  id           String              @id @default(uuid(7)) @db.Uuid
  key          String              @unique
  surface      PlacementSurface
  name         String
  /// Görsel sıra (1 tabanlı, organik + sponsorlu birleşik listede).
  positions    Int[]
  maxItems     Int                 @map("max_items")
  /// Boş = tüm listeleme türleri.
  allowedKinds ListingKind[]       @map("allowed_kinds")
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int                 @default(1)
  placements   CampaignPlacement[]

  @@map("placement_slots")
}

/// Kampanya (Ek A8.4). Tutar yalnızca `campaigns.amount` yetkisiyle görülür/değişir.
model Campaign {
  id                    String              @id @default(uuid(7)) @db.Uuid
  name                  String
  sponsorId             String              @map("sponsor_id") @db.Uuid
  sponsor               Organization        @relation(fields: [sponsorId], references: [id], onDelete: Restrict)
  status                CampaignStatus      @default(DRAFT)
  startsAt              DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime            @map("ends_at") @db.Timestamptz(3)
  budgetKurus           BigInt?             @map("budget_kurus")
  currency              String              @default("TRY")
  contractRef           String?             @map("contract_ref")
  salesApprovedById     String?             @map("sales_approved_by") @db.Uuid
  salesApprovedAt       DateTime?           @map("sales_approved_at") @db.Timestamptz(3)
  editorialApprovedById String?             @map("editorial_approved_by") @db.Uuid
  editorialApprovedAt   DateTime?           @map("editorial_approved_at") @db.Timestamptz(3)
  dataOrigin            DataOrigin          @default(EDITORIAL) @map("data_origin")
  createdById           String?             @map("created_by") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  version               Int                 @default(1)
  placements            CampaignPlacement[]
  creatives             Creative[]

  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

/// Yerleşim: yuva + öne çıkarılan listeleme + bağlamsal hedefleme (kategori/bölge; kişisel sinyal yok — REQ-SPN-012).
model CampaignPlacement {
  id               String           @id @default(uuid(7)) @db.Uuid
  campaignId       String           @map("campaign_id") @db.Uuid
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  slotId           String           @map("slot_id") @db.Uuid
  slot             PlacementSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  listingId        String           @map("listing_id") @db.Uuid
  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  targetCategoryId String?          @map("target_category_id") @db.Uuid
  targetAreaId     String?          @map("target_area_id") @db.Uuid
  priority         Int              @default(0)
  weight           Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  events           SponsoredEvent[]

  @@index([slotId])
  @@index([listingId])
  @@map("campaign_placements")
}

/// Kreatif (REQ-SPN-001): metin editoryal onaydan geçmeden gösterilmez; etiket türü sabit sözlükten.
model Creative {
  id           String             @id @default(uuid(7)) @db.Uuid
  campaignId   String             @map("campaign_id") @db.Uuid
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  body         String?
  labelType    CommercialRelation @default(SPONSORED) @map("label_type")
  approval     CreativeApproval   @default(PENDING)
  reviewedById String?            @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int                @default(1)

  @@map("creatives")
}

/// Sponsorlu yerleşim olayı (REQ-SPN-009/010): ham IP yok; bot/önceden getirme/personel/demo işaretli;
/// `counted` = raporlara giren (tekilleştirme sonrası).
model SponsoredEvent {
  id          BigInt             @id @default(autoincrement())
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  placementId String             @map("placement_id") @db.Uuid
  placement   CampaignPlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  type        SponsoredEventType
  surface     PlacementSurface
  sessionHash String?            @map("session_hash")
  bot         Boolean            @default(false)
  prefetch    Boolean            @default(false)
  demo        Boolean            @default(false)
  counted     Boolean

  @@index([placementId, type, createdAt])
  @@index([sessionHash, placementId, type, createdAt])
  @@map("sponsored_events")
}

/// Sponsor bağlantılı listelemenin değerlendirmesini kaldırma: ikinci moderatör onayı (REQ-GUN-004).
model ReviewRemovalRequest {
  id            String    @id @default(uuid(7)) @db.Uuid
  reviewId      String    @map("review_id") @db.Uuid
  review        Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /// Bildirimden geldiyse bildirim kimliği.
  reportId      String?   @map("report_id") @db.Uuid
  requestedById String    @map("requested_by") @db.Uuid
  reasonCode    String    @map("reason_code")
  note          String?
  /// PENDING | CONFIRMED | DECLINED
  status        String    @default("PENDING")
  decidedById   String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("review_removal_requests")
}

/// Kaydedilenler (favoriler): yalnızca sahibine görünür; hesap silinince silinir (REQ-KVK-021).
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id") @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

/// Rıza kayıtları (REQ-KVK-003): yalnızca eklenir; IP yerine anahtarlı karma; rıza verildiği kadar kolay geri alınır.
model ConsentRecord {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Oturum açıksa üye; hesap silinince ayrılır.
  userId      String?  @map("user_id") @db.Uuid
  anonymousId String   @map("anonymous_id") @db.Uuid
  /// FUNCTIONAL | ANALYTICS | MARKETING
  purpose     String
  granted     Boolean
  textVersion String   @map("text_version")
  /// WEB | IOS | ANDROID
  channel     String
  ipHash      String?  @map("ip_hash")

  @@index([anonymousId, createdAt])
  @@index([userId])
  @@map("consent_records")
}
